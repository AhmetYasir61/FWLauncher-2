<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "POST, GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, x-pokeface-name, x-pokeface-price, x-pokeface-currency, x-pokeface-author, x-signature"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preflight (OPTIONS) isteklerini engelsiz yanıtla
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]

    # Sadece market adreslerini endpoint parametresiyle market_proxy.php dosyasına aktar
    RewriteRule ^(cosmetic\.json|session|download/.*|tebex/webhook|publish|health)$ market_proxy.php?endpoint=$1 [L,QSA]
</IfModule>
# Gizli ayar ve log dosyalarına dışarıdan erişimi kapat
<FilesMatch "^(secrets\.php|secrets\.example\.php|fw_secrets\.php|.*\.log|pw_schema\.sql)$">
    Require all denied
</FilesMatch>
